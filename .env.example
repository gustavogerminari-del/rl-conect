# RL CONNECT — variáveis de ambiente / Secrets
# Nunca coloque valores reais neste arquivo versionado.

# URL pública da aplicação. Sem barra final.
APP_URL="https://SEU-DOMINIO"

# Firebase Web (a API key Web identifica o projeto; a segurança real fica no Auth/Rules).
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="rl-connect-ed797.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="rl-connect-ed797"
VITE_FIREBASE_STORAGE_BUCKET="rl-connect-ed797.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="424978245385"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Firebase Admin — SOMENTE servidor.
# Necessário para APIs administrativas e para armazenar a integração Google por empresa.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"YOUR_PROJECT_ID","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"}'

# Google Workspace / Calendar / Meet — SOMENTE servidor.
# Crie um OAuth Client do tipo Web Application no Google Cloud.
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
# Este endereço deve estar cadastrado EXATAMENTE nos Authorized redirect URIs do Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI="https://SEU-DOMINIO/api/google/workspace/callback"
# String aleatória forte (mínimo 24 caracteres) usada para assinar o state OAuth.
GOOGLE_OAUTH_STATE_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
# Base64 de 32 bytes aleatórios; criptografa access/refresh tokens do Google no Firestore.
GOOGLE_WORKSPACE_ENCRYPTION_KEY="BASE64_32_BYTE_RANDOM_KEY"

# Gemini API — SOMENTE servidor.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# Modelo estável atual usado nas rotas de currículo/triagem/vaga.
GEMINI_MODEL="gemini-3.6-flash"

# OpenAI — SOMENTE servidor. Usado pelo assistente da Área do Programador quando configurado.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# Opcional. O código possui fallback próprio caso não seja definido.
OPENAI_MODEL="gpt-5-mini"

# Criptografia das chaves de IA salvas pela Área do Programador.
# Base64 de 32 bytes aleatórios.
MASTER_AI_ENCRYPTION_KEY="BASE64_32_BYTE_RANDOM_KEY"

# Cloudflare deploy (configurados como GitHub Actions Secrets, não necessariamente no runtime da aplicação).
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
