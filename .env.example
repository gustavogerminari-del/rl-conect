# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública do RL Connect. Usada para callbacks OAuth e links internos.
APP_URL="http://localhost:3000"

# Supabase usado pelo frontend (Auth normal do RL Connect)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Supabase usado SOMENTE no servidor para validar a sessão RL Connect e armazenar tokens Google.
# Nunca exponha SUPABASE_SERVICE_ROLE_KEY no frontend.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google Calendar / Meet OAuth 2.0
# O OAuth abaixo serve EXCLUSIVAMENTE para Calendar/Meet. NÃO é login do RL Connect.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Se vazio, o servidor usa: ${APP_URL}/api/integrations/google/calendar/callback
GOOGLE_REDIRECT_URI=""

# Segredos de segurança do OAuth Google
# GOOGLE_TOKEN_ENCRYPTION_KEY: 32 bytes, em base64, ou 64 caracteres hexadecimais.
# Exemplo de geração: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=""
# Segredo HMAC forte para assinar e validar o state OAuth.
# Exemplo de geração: openssl rand -hex 32
GOOGLE_OAUTH_STATE_SECRET=""
