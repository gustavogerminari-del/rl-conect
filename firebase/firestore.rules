rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function usuarioPath() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function legacyUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasUsuario() { return signedIn() && exists(usuarioPath()); }
    function hasLegacyUser() { return signedIn() && !hasUsuario() && exists(legacyUserPath()); }
    function hasProfile() { return hasUsuario() || hasLegacyUser(); }
    function profile() { return hasUsuario() ? get(usuarioPath()).data : get(legacyUserPath()).data; }
    function role() { return hasProfile() ? (profile().role != null ? profile().role : profile().tipoUsuario) : ''; }
    function master() { return hasProfile() && (profile().isMaster == true || role() in ['master_admin','MASTER','MASTER_ADMIN','SUPER_ADMINISTRADOR','Super Administrador']); }
    function tenant() {
      return hasProfile()
        ? (profile().empresa_id != null ? profile().empresa_id
          : (profile().empresaId != null ? profile().empresaId
          : (profile().companyId != null ? profile().companyId : profile().tenantId)))
        : '';
    }
    function dataTenant(d) {
      return d.empresa_id != null ? d.empresa_id
        : (d.empresaId != null ? d.empresaId
        : (d.companyId != null ? d.companyId : d.tenantId));
    }
    function active() {
      return hasProfile()
        && profile().ativo != false
        && !(profile().status in ['Inativo','Bloqueado','Suspenso','inativo','bloqueado','suspenso']);
    }
    function sameTenant(d) { return active() && tenant() != '' && dataTenant(d) == tenant(); }
    function access(d) { return active() && (master() || sameTenant(d)); }
    function publicJob(d) {
      return (d.publicado == true || d.publicada == true)
        && !(d.status in ['encerrada','Encerrada','fechada','Fechada','cancelada','Cancelada']);
    }
    function protectedServerCollection(name) {
      return name in ['google_workspace_integrations','google_oauth_states','google_calendar_integrations','oauth_tokens','secrets'];
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || master() || sameTenant(resource.data));
      allow create, delete: if master();
      allow update: if master() || (active() && request.auth.uid == uid && sameTenant(resource.data) && sameTenant(request.resource.data));
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || master() || sameTenant(resource.data));
      allow write: if master();
    }

    match /empresas/{id} {
      allow read: if master() || (active() && tenant() == id) || resource.data.portal_publico == true;
      allow write: if master();
    }

    match /vagas/{id} {
      allow read: if publicJob(resource.data) || access(resource.data);
      allow create: if access(request.resource.data);
      allow update: if access(resource.data) && access(request.resource.data);
      allow delete: if access(resource.data);
    }

    // Public applications must go through the validated server endpoint using Firebase Admin.
    // Direct anonymous writes to candidate/application collections are forbidden.
    match /candidatos/{id} {
      allow read: if access(resource.data);
      allow create: if access(request.resource.data);
      allow update: if access(resource.data) && access(request.resource.data);
      allow delete: if access(resource.data);
    }
    match /candidates/{id} {
      allow read: if access(resource.data);
      allow create: if access(request.resource.data);
      allow update: if access(resource.data) && access(request.resource.data);
      allow delete: if access(resource.data);
    }
    match /candidaturas/{id} {
      allow read: if access(resource.data);
      allow create: if access(request.resource.data);
      allow update: if access(resource.data) && access(request.resource.data);
      allow delete: if access(resource.data);
    }

    // Google OAuth tokens and one-time states are server-only. Firebase Admin bypasses client rules.
    match /google_workspace_integrations/{id} { allow read, write: if false; }
    match /google_oauth_states/{id} { allow read, write: if false; }
    match /google_calendar_integrations/{id} { allow read, write: if false; }
    match /oauth_tokens/{id} { allow read, write: if false; }
    match /secrets/{id} { allow read, write: if false; }

    match /{collectionName}/{id} {
      allow read: if !protectedServerCollection(collectionName) && access(resource.data);
      allow create: if !protectedServerCollection(collectionName) && access(request.resource.data);
      allow update: if !protectedServerCollection(collectionName) && access(resource.data) && access(request.resource.data);
      allow delete: if !protectedServerCollection(collectionName) && access(resource.data);
    }
  }
}
