rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasPrimary() { return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function hasLegacy() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function primary() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function legacy() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    function profileActive(data) {
      return (!('ativo' in data) || data.ativo != false)
        && (!('status' in data) || (
          data.status != 'Inativo' && data.status != 'INATIVO'
          && data.status != 'Bloqueado' && data.status != 'BLOQUEADO'
          && data.status != 'Suspenso' && data.status != 'SUSPENSO'
          && data.status != 'Desativado' && data.status != 'DESATIVADO'
        ));
    }

    // usuarios/{uid} é a fonte canônica. users/{uid} é apenas fallback legado.
    function active() {
      return signedIn() && (
        (hasPrimary() && profileActive(primary())) ||
        (!hasPrimary() && hasLegacy() && profileActive(legacy()))
      );
    }

    function masterRole(value) {
      return value in ['master_admin','MASTER_ADMIN','MASTER','SUPER_ADMINISTRADOR','Super Administrador'];
    }
    function developerRole(value) {
      return value in ['developer_admin','DEVELOPER_ADMIN','DEVELOPER','DESENVOLVEDOR'];
    }
    function operatorRole(value) {
      return value in [
        'ADMIN_EMPRESA','ADMIN','ADMINISTRADOR','Administrador','ADMINISTRADOR_EMPRESA','Administrador da Empresa',
        'EMPRESA_ADMIN','GESTOR_EMPRESA','GESTOR','EMPRESA','RH','DP','HEADHUNTER','RECRUTADOR','FINANCEIRO',
        'RECRUTAMENTO','Recrutamento','RECRUTAMENTO_HEADHUNTER','RECRUTAMENTO / HEADHUNTER','RECRUTAMENTO/HEADHUNTER',
        'Recrutamento / Headhunter','RECRUTADOR_SÊNIOR','Recrutador Sênior','RECRUTADOR SENIOR','ANALISTA_DE_RH',
        'Analista de RH','ANALISTA RH','GESTOR_DE_SELEÇÃO','Gestor de Seleção','GESTOR DE SELECAO'
      ];
    }
    function companyAdminRole(value) {
      return value in ['ADMIN_EMPRESA','ADMIN','ADMINISTRADOR','Administrador','ADMINISTRADOR_EMPRESA','Administrador da Empresa','EMPRESA_ADMIN','GESTOR_EMPRESA'];
    }

    function fieldRole(data) { return ('role' in data) ? data.role : ''; }
    function fieldTipoUsuario(data) { return ('tipoUsuario' in data) ? data.tipoUsuario : ''; }
    function profileIsMaster(data) { return masterRole(fieldRole(data)) || masterRole(fieldTipoUsuario(data)); }
    function profileIsDeveloper(data) { return developerRole(fieldRole(data)) || developerRole(fieldTipoUsuario(data)); }
    function profileIsPlatform(data) { return profileIsMaster(data) || profileIsDeveloper(data); }

    function master() {
      return signedIn() && (
        (hasPrimary() && profileIsMaster(primary())) ||
        (!hasPrimary() && hasLegacy() && profileIsMaster(legacy()))
      );
    }
    function developer() {
      return active() && (
        (hasPrimary() && profileIsDeveloper(primary())) ||
        (!hasPrimary() && hasLegacy() && profileIsDeveloper(legacy()))
      );
    }
    function technicalPlatformAccess() { return master() || developer(); }
    function tenantOperator() {
      return active() && (
        (hasPrimary() && (operatorRole(fieldRole(primary())) || operatorRole(fieldTipoUsuario(primary())))) ||
        (!hasPrimary() && hasLegacy() && (operatorRole(fieldRole(legacy())) || operatorRole(fieldTipoUsuario(legacy()))))
      );
    }
    function companyAdmin() {
      return active() && (
        (hasPrimary() && (companyAdminRole(fieldRole(primary())) || companyAdminRole(fieldTipoUsuario(primary())))) ||
        (!hasPrimary() && hasLegacy() && (companyAdminRole(fieldRole(legacy())) || companyAdminRole(fieldTipoUsuario(legacy()))))
      );
    }

    function dataTenant(data) {
      return ('empresa_id' in data && data.empresa_id is string && data.empresa_id != '') ? data.empresa_id
        : ('empresaId' in data && data.empresaId is string && data.empresaId != '') ? data.empresaId
        : ('companyId' in data && data.companyId is string && data.companyId != '') ? data.companyId
        : ('tenantId' in data && data.tenantId is string && data.tenantId != '') ? data.tenantId
        : '';
    }
    function tenantId() {
      return hasPrimary() ? dataTenant(primary())
        : hasLegacy() ? dataTenant(legacy())
        : '';
    }
    function sameTenant(data) { return active() && tenantId() != '' && dataTenant(data) == tenantId(); }
    function tenantWrite(data) { return tenantOperator() && tenantId() != '' && dataTenant(data) == tenantId(); }
    function tenantUpdate(oldData, newData) {
      return tenantOperator() && tenantId() != '' && dataTenant(newData) == tenantId()
        && (dataTenant(oldData) == tenantId() || dataTenant(oldData) == '');
    }

    function safeCompanyBrandingUpdate(id) {
      return companyAdmin() && tenantId() == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'empresa_id','empresaId','companyId','tenantId',
          'nome','logo_url','banner_url','descricao','cor_principal',
          'contato_email','contato_telefone','website','linkedin_url','instagram_url',
          'updatedAt','updatedBy','atualizado_em'
        ]);
    }

    function jobIdFrom(data) {
      return ('jobId' in data && data.jobId is string && data.jobId != '') ? data.jobId
        : ('vagaId' in data && data.vagaId is string && data.vagaId != '') ? data.vagaId
        : ('vaga_id' in data && data.vaga_id is string && data.vaga_id != '') ? data.vaga_id
        : '';
    }
    function candidateIdFrom(data) {
      return ('candidateId' in data && data.candidateId is string && data.candidateId != '') ? data.candidateId
        : ('candidatoId' in data && data.candidatoId is string && data.candidatoId != '') ? data.candidatoId
        : ('candidato_id' in data && data.candidato_id is string && data.candidato_id != '') ? data.candidato_id
        : '';
    }
    function publicJob(data) {
      return ((('publicada' in data) && data.publicada == true) || (('publicado' in data) && data.publicado == true))
        && dataTenant(data) != ''
        && (!('status' in data) || (
          data.status != 'Encerrada' && data.status != 'encerrada' && data.status != 'ENCERRADA'
          && data.status != 'Fechada' && data.status != 'fechada' && data.status != 'FECHADA'
          && data.status != 'Cancelada' && data.status != 'cancelada' && data.status != 'CANCELADA'
        ));
    }
    function publicJobOwner(jobId, companyId) {
      return jobId != '' && companyId != ''
        && exists(/databases/$(database)/documents/vagas/$(jobId))
        && publicJob(get(/databases/$(database)/documents/vagas/$(jobId)).data)
        && dataTenant(get(/databases/$(database)/documents/vagas/$(jobId)).data) == companyId;
    }
    function validApplication(data) {
      return candidateIdFrom(data) != '' && publicJobOwner(jobIdFrom(data), dataTenant(data));
    }
    function validPublicCandidate(data) {
      let name = ('name' in data && data.name is string && data.name != '') ? data.name
        : (('nome' in data && data.nome is string) ? data.nome : '');
      return name != '' && ('email' in data) && data.email is string && data.email != ''
        && publicJobOwner(jobIdFrom(data), dataTenant(data));
    }

    function operationalCollection(name) {
      return name in [
        'clientes','entrevistas','interviews','agenda','solicitacoes_admissao','colaboradores','historico_colaborador',
        'funcionarios','employees','internal_team','departamentos','cargos','documentos','documents','documentos_colaboradores',
        'contratos_trabalho','jornadas','registroPontos','marcacoes_ponto','ajustes_ponto','banco_horas','beneficios',
        'beneficios_colaboradores','beneficios_catalogo','employee_benefits','ferias_solicitacoes','historico_beneficios',
        'anotacoes_internas_colaborador','ferias','periodos_aquisitivos','regras_ferias','afastamentos','cat_registros',
        'inss_processos','retorno_trabalho','alertas_dp','folhas_pagamento','rescisoes','solicitacoes_portal','chamados_suporte',
        'comunicados_empresa','documentos_assinatura_portal','organograma_empresa','cargos_salarios','ponto_registros','registros_ponto',
        'timeClock','escalas_ponto','escalas','configuracoes_ponto','comprovantes_ponto','logs_ponto','solicitacoes_horas_extras',
        'fechamentos_ponto','payroll','payroll_periods','payroll_stubs','esocial_events','sst_ambientes','sst_riscos','sst_programas',
        'sst_planos_acao','sst_agendamentos_exame','sst_resultados_aso','sst_epis_catalogo','sst_entregas_epi','sst_treinamentos_catalogo',
        'sst_acidentes','sst_cats','relatorios','logs','auditLogs','notifications','notificacoes','headhunter_clients','terminations',
        'termination_event_rules','headhunter_contracts','headhunter_hirings','headhunter_finance','headhunter_leads','headhunter_proposals',
        'despesas','comissoes','garantias','historicos_financeiros','builder_pages','builder_versions','builder_fields','builder_menus',
        'builder_themes','builder_templates','builder_audit_logs','ai_builder_modules','ai_builder_versions','ai_logs','ai_match_auditoria',
        'exames_ocupacionais','dp_beneficios','dp_folhas','dp_afastamentos','dp_retornos','dp_historico'
      ];
    }

    match /_health/{id} { allow read: if true; allow write: if false; }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || master() || (sameTenant(resource.data) && !profileIsPlatform(resource.data)));
      allow create: if master() || (companyAdmin() && sameTenant(request.resource.data) && !profileIsPlatform(request.resource.data));
      allow update: if master() || (companyAdmin() && sameTenant(resource.data) && sameTenant(request.resource.data) && !profileIsPlatform(resource.data) && !profileIsPlatform(request.resource.data));
      allow delete: if master() && !profileIsMaster(resource.data);
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || master() || (sameTenant(resource.data) && !profileIsPlatform(resource.data)));
      allow create: if master() || (companyAdmin() && sameTenant(request.resource.data) && !profileIsPlatform(request.resource.data));
      allow update: if master() || (companyAdmin() && sameTenant(resource.data) && sameTenant(request.resource.data) && !profileIsPlatform(resource.data) && !profileIsPlatform(request.resource.data));
      allow delete: if master() && !profileIsMaster(resource.data);
    }

    match /empresas/{id} {
      allow read: if master() || (active() && tenantId() == id);
      allow create, delete: if master();
      allow update: if master() || safeCompanyBrandingUpdate(id);
    }
    match /companies/{id} { allow read: if master() || (active() && tenantId() == id); allow write: if master(); }
    match /tenants/{id} { allow read: if master() || (active() && tenantId() == id); allow write: if master(); }
    match /empresa_modulos/{id} { allow read: if master() || (active() && tenantId() == id); allow write: if master(); }
    match /empresaModulos/{id} { allow read: if master() || sameTenant(resource.data); allow write: if master(); }
    match /companyModules/{id} { allow read: if master() || sameTenant(resource.data); allow write: if master(); }
    match /subscriptions/{id} { allow read: if master() || sameTenant(resource.data); allow write: if master(); }
    match /assinaturas/{id} { allow read: if master() || sameTenant(resource.data); allow write: if master(); }
    match /pagamentos/{id} { allow read: if master() || sameTenant(resource.data); allow write: if master(); }

    match /vagas/{id} {
      allow read: if publicJob(resource.data) || master() || sameTenant(resource.data);
      allow create: if master() || tenantWrite(request.resource.data);
      allow update: if master() || tenantUpdate(resource.data, request.resource.data);
      allow delete: if master() || (tenantOperator() && sameTenant(resource.data));
    }
    match /jobs/{id} { allow read: if publicJob(resource.data) || master() || sameTenant(resource.data); allow write: if false; }
    match /candidatos/{id} {
      allow create: if validPublicCandidate(request.resource.data) || master() || tenantWrite(request.resource.data);
      allow read: if master() || sameTenant(resource.data);
      allow update: if master() || tenantUpdate(resource.data, request.resource.data);
      allow delete: if master() || (tenantOperator() && sameTenant(resource.data));
    }
    match /candidates/{id} { allow read: if master() || sameTenant(resource.data); allow write: if false; }
    match /candidaturas/{id} {
      allow create: if validApplication(request.resource.data) || master() || tenantWrite(request.resource.data);
      allow read: if master() || sameTenant(resource.data);
      allow update: if master() || tenantUpdate(resource.data, request.resource.data);
      allow delete: if master() || (tenantOperator() && sameTenant(resource.data));
    }
    match /candidate_applications/{id} { allow read: if master() || sameTenant(resource.data); allow write: if false; }
    match /applications/{id} { allow read: if master() || sameTenant(resource.data); allow write: if false; }

    match /clientes_headhunter/{id} {
      allow read: if master() || sameTenant(resource.data);
      allow create: if master() || tenantWrite(request.resource.data);
      allow update: if master() || tenantUpdate(resource.data, request.resource.data);
      allow delete: if master() || (tenantOperator() && sameTenant(resource.data));
    }
    match /contratacoes/{id} {
      allow read: if master() || sameTenant(resource.data);
      allow create: if master() || tenantWrite(request.resource.data);
      allow update: if master() || tenantUpdate(resource.data, request.resource.data);
      allow delete: if master() || (tenantOperator() && sameTenant(resource.data));
    }
    match /financeiro_cobrancas/{id} {
      allow read: if master() || sameTenant(resource.data);
      allow create: if master() || tenantWrite(request.resource.data);
      allow update: if master() || tenantUpdate(resource.data, request.resource.data);
      allow delete: if master() || (tenantOperator() && sameTenant(resource.data));
    }
    match /receitas/{id} {
      allow read: if master() || sameTenant(resource.data);
      allow create: if master() || tenantWrite(request.resource.data);
      allow update: if master() || tenantUpdate(resource.data, request.resource.data);
      allow delete: if master() || (tenantOperator() && sameTenant(resource.data));
    }
    match /audit_logs/{id} {
      allow read: if master() || sameTenant(resource.data);
      allow create: if master() || tenantWrite(request.resource.data);
      allow update: if master() || tenantUpdate(resource.data, request.resource.data);
      allow delete: if master() || (tenantOperator() && sameTenant(resource.data));
    }

    match /{collectionName}/{id} {
      allow read: if operationalCollection(collectionName) && (master() || sameTenant(resource.data));
      allow create: if operationalCollection(collectionName) && (master() || tenantWrite(request.resource.data));
      allow update: if operationalCollection(collectionName) && (master() || tenantUpdate(resource.data, request.resource.data));
      allow delete: if operationalCollection(collectionName) && (master() || (tenantOperator() && sameTenant(resource.data)));
    }

    match /modulos/{id} { allow read: if active(); allow write: if master(); }
    match /modules/{id} { allow read: if active(); allow write: if master(); }
    match /planos/{id} { allow read: if active(); allow write: if master(); }

    match /master_leads/{id} { allow read, write: if master(); }
    match /master_finance_receivables/{id} { allow read, write: if master(); }
    match /master_finance_payables/{id} { allow read, write: if master(); }
    match /master_nfse/{id} { allow read, write: if master(); }
    match /master_support_tickets/{id} { allow read, write: if master(); }
    match /master_integrations/{id} { allow read, write: if master(); }
    match /master_backups/{id} { allow read, write: if master(); }
    match /master_settings/{id} { allow read, write: if master(); }
    match /master_idempotency/{id} { allow read, write: if master(); }
    match /ai_settings/{id} { allow read, write: if master(); }

    match /developer_credentials/{id} {
      allow read, create, update: if technicalPlatformAccess() && id == 'developer_credentials_' + request.auth.uid;
      allow delete: if false;
    }
    match /developer_code_drafts/{id} {
      allow read: if technicalPlatformAccess() && resource.data.createdBy == request.auth.uid;
      allow create: if technicalPlatformAccess() && request.resource.data.createdBy == request.auth.uid;
      allow update: if technicalPlatformAccess() && resource.data.createdBy == request.auth.uid && request.resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }
    match /developer_visual_drafts/{id} {
      allow read: if technicalPlatformAccess();
      allow create: if technicalPlatformAccess() && request.resource.data.createdBy == request.auth.uid && request.resource.data.appliedToProduction == false;
      allow update, delete: if false;
    }
    match /developer_logs/{id} { allow read, create: if technicalPlatformAccess(); allow update, delete: if false; }
    match /developer_test_runs/{id} { allow read, create: if technicalPlatformAccess(); allow update, delete: if false; }
    match /developer_versions/{id} { allow read, create: if technicalPlatformAccess(); allow update, delete: if false; }

    match /google_workspace_integrations/{id} {
      allow read: if master() || (tenantOperator() && tenantId() == id && sameTenant(resource.data));
      allow create: if master() || (tenantOperator() && tenantId() == id && tenantWrite(request.resource.data));
      allow update: if master() || (tenantOperator() && tenantId() == id && tenantUpdate(resource.data, request.resource.data));
      allow delete: if master() || (tenantOperator() && tenantId() == id && sameTenant(resource.data));
    }
    match /google_oauth_states/{id} { allow read, write: if false; }
    match /interview_transcripts/{id} { allow read, write: if false; }
    match /interview_diagnostics/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
